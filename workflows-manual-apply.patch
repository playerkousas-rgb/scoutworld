@@ -0,0 +1,66 @@
+name: Data quality check
+
+on:
+  push:
+    branches: [main]
+    paths:
+      - 'data/**'
+      - 'index.html'
+      - 'sw.js'
+      - 'tools_data_quality.py'
+      - 'tools_search_index_build.py'
+      - '.github/workflows/data-quality.yml'
+  pull_request:
+    paths:
+      - 'data/**'
+      - 'index.html'
+      - 'sw.js'
+      - 'tools_data_quality.py'
+      - 'tools_search_index_build.py'
+      - '.github/workflows/data-quality.yml'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  data-quality:
+    name: 靜態資料品質檢查
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+
+      - name: Set up Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+
+      - name: node --check（語法檢查）
+        run: |
+          node --check sw.js
+          node --check tools_runtime_test.js
+
+      - name: 資料品質檢查（tools_data_quality.py）
+        run: python3 tools_data_quality.py
+
+      - name: JSON 檔案格式驗證
+        run: |
+          python3 - <<'PY'
+          import glob, json, sys
+          bad = []
+          for f in glob.glob('data/**/*.json', recursive=True):
+              try:
+                  json.load(open(f, encoding='utf-8'))
+              except Exception as exc:
+                  bad.append(f'{f}: {exc}')
+          for b in bad:
+              print('ERROR', b)
+          sys.exit(1 if bad else 0)
+          PY
