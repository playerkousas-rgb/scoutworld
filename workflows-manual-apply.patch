+name: jsdom runtime test
+
+on:
+  push:
+    branches: [main]
+    paths:
+      - 'data/**'
+      - 'index.html'
+      - 'sw.js'
+      - 'package.json'
+      - 'package-lock.json'
+      - 'tools_runtime_test.js'
+      - '.github/ISSUE_TEMPLATE/**'
+      - '.github/workflows/runtime-test.yml'
+  pull_request:
+    paths:
+      - 'data/**'
+      - 'index.html'
+      - 'sw.js'
+      - 'package.json'
+      - 'package-lock.json'
+      - 'tools_runtime_test.js'
+      - '.github/ISSUE_TEMPLATE/**'
+      - '.github/workflows/runtime-test.yml'
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  runtime-test:
+    name: jsdom runtime tests（waves 1–28）
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Set up Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+          cache: npm
+
+      - name: npm ci
+        run: npm ci
+
+      - name: 啟動本地靜態伺服器（localhost:8080）
+        run: |
+          python3 -m http.server 8080 &
+          for i in $(seq 1 20); do
+            if curl -sf http://localhost:8080/index.html > /dev/null; then
+              echo "Server ready"; break
+            fi
+            sleep 0.5
+          done
+
+      - name: npm run test:runtime
+        run: npm run test:runtime
